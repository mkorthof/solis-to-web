# CONFIGURATION

# Host or IP of MQTT broker
BROKER_HOST = "10.20.30.40"
BROKER_PORT = 1883

# Broker Auth (optional), default is "solis/solis"
BROKER_USERNAME = "solis"
BROKER_PASSWORD = "solis"

# Subscribe to topic '/ginlong/<serial>/update', where <serial>
# is the device serial number of the Datalogger (Ginglong Technologies is Solis)
TOPIC = "/ginlong/1A123456ABC0123F/update"

# Inverter ID, default is '1'
INVERTER_ID = "INVERTER1"

# Collector ID, default is '11'
COLLECTOR_ID = "COLLECTOR11"

# Offset hours to inverter timestamp
TS_OFFSET = 7

# Use both files and sqlite database to store json data (default)
# Files and db size will be ~300MB per year
# Disabling DB will slow down generating output html for plots and messages
# If both are disabled only todays data is shown (untested)
USE_FILES = True
USE_DB = True

# Base web directory for html files etc
WEBDIR = "./htdocs"

# Do not show Messages and mask device serial etc in output, e.g. when serving web dir publicly 
MASK = False

# Title of html pages
TITLE = "☀️ Solis 2 Web"
HEADER = '<img src="static/sun.svg" class="icon"> Solis 2 Web'

# Show plot types on index page for today and yesterday, 
INDEX_PLOT_TYPES = ['E_TODAY', 'DC_TOTALPOWER', 'APPARENT_POWER']

# All available periods: 'today', 'yesterday', 'week', 'month', 'year', 'this_month', 'this_year'
USE_PERIODS = ['today', 'yesterday', 'week', 'month', 'year']

# Link to plots for these periods and types
LINK_PLOT_PERIODS = ['week', 'month', 'year']
LINK_PLOT_TYPES = ['E_TODAY', 'DC_TOTALPOWER']

# Links to older messages
LINK_PREVIOUS_MESSAGES = ['week', 'month', 'year' ]

# Create static files in web dir
WEBSTATIC = True

# Files in {WEBDIR}/static. If you set WEBSTATIC to False you'll have manually copy them.
WEBSTATIC_FILES = [
    "helper.js",
    "assets/css/simple.css",
    "assets/css/custom.css",
    "assets/img/collector.svg",
    "assets/img/electricity.svg",
    "assets/img/happy.svg",
    "assets/img/apower.svg", 
    "assets/img/sun.svg",   
]

# Plots definitions
#   "field" gets y-axis values: {
#       'name' used in title,
#       'div' divides field values (e.g. 1000 for W to kW),
#       'unit' for y label,
#       'color' for line,
#       'num': [0-3] to select PV1-4, default is 0 (optional)
#       'disabled': True|False, default is False (optional)
#   }
PLOTS = {
    "APPARENT_POWER": { 'name': 'Apparent Power', 'div': 1000, 'unit': 'VA', 'color': 'darkred'},
    "DC_TOTALPOWER": { 'name': 'DC Total Power', 'div': 1000, 'unit': 'kW', 'color': 'red' },   # SolisCloud: DC Power PV1 (W)
    "REACTIVE_POWER": { 'name': 'Reactive Power', 'unit': 'Var', 'color': 'purple' },
    "POWER_FACTOR": { 'name': 'Power Factor', 'unit': 'pf%', 'color': 'blue' },
    "E_TODAY": { 'name': 'Energy Yield', 'div': 10, 'unit': 'kWh', 'color': 'green' },
    "U_PV": { 'name': 'DC Voltage PV', 'unit': 'V', 'color': 'brown', 'num': 0 },
    "I_PV": { 'name': 'DC Current PV', 'unit': 'A', 'color': 'orange', 'num': 0  },
    "U_MPPT": { 'name': 'DC Voltage MPPT ', 'unit': 'V', 'color': 'brown', 'num': 0  },
    "I_MPPT": { 'name': 'DC Current MPPT ', 'unit': 'A', 'color': 'orange', 'num': 0  },
    "U_AC": { 'name': 'AC Voltage', 'unit': 'V', 'color': 'brown', 'num': 0  },
    "I_AC": { 'name': 'AC Current', 'unit': 'A', 'color': 'orange', 'num': 0  },
    "PAC": { 'name': 'AC Output Total Power', 'unit': 'kW', 'color': 'hotpink', 'disabled': False},
    "FAC": { 'name': 'AC Frequency', 'unit': 'Hz', 'color': 'teal', 'disabled': True },
}

DEBUG = False