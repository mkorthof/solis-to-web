# SOLIS 2 WEB CONFIGURATION

# Host or IP of MQTT broker
BROKER_HOST = "10.20.30.40"
BROKER_PORT = 1883

# Broker Auth (optional), default is "solis/solis"
BROKER_USERNAME = "solis"
BROKER_PASSWORD = "solis"

# Subscribe to topic '/ginlong/<serial>/update', where <serial>
# is the device serial number of the Datalogger (Ginglong Technologies is Solis)
TOPIC = "/ginlong/1A123456ABC0123F/update"

# Inverter ID, default is '1'
INVERTER_ID = "INVERTER1"

# Collector ID, default is '11'
COLLECTOR_ID = "COLLECTOR11"

# Offset hours to inverter timestamp
TS_OFFSET = 7

# Use both files and sqlite database to store json data (default)
# Disabling DB will slow down generating output html for plots and messages
# If both are disabled only todays data is shown (untested)
STORE_FILES = True
USE_DATABASE = True
# SQLite db file, default "solis.db"
FN_DB = "solis.db"

# Base web directory for html files etc and subdirs
WEBDIR = "./htdocs"
JSONDIR = "json"
PLOTDIR = "plot"

# Title of html pages
TITLE = "☀️ Solis 2 Web"
HEADER = '<img src="static/sun.svg" class="icon"> Solis 2 Web'

# Select periods to use for plots and messages.
# Available: 'today', 'yesterday', 'week', 'month', 'year', 'this_month', 'this_year'
PERIODS = ['today', 'yesterday', 'week', 'month', 'year']

# Generate plots for periods using these types
PLOT_TYPES = ['E_TODAY', 'DC_TOTALPOWER']

# Set plots on index page to always show unfolded
INDEX_PLOT_TYPES = ['E_TODAY', 'DC_TOTALPOWER', 'APPARENT_POWER']

# Create static files in web dir
WEBSTATIC = True
# Files in WEBDIR/static. If you set WEBSTATIC to False you'll have manually copy them.
WEBSTATIC_FILES = [
    "helper.js",
    "assets/css/simple.css",
    "assets/css/custom.css",
    "assets/img/collector.svg",
    "assets/img/electricity.svg",
    "assets/img/happy.svg",
    "assets/img/apower.svg", 
    "assets/img/sun.svg",
    "assets/img/chart.svg",
    "assets/img/link.svg",    
]

# Plots definitions
#   "field" gets y-axis values: {
#       'name' used in title,
#       'div' divides field values (e.g. 1000 for W to kW), default is 1,
#       'unit' for y label,
#       'type' bar or line,
#       'color' for line,
#       'num': [0-3] to select PV1-4, default is 0 (optional)
#       'disabled': True|False, default is False (optional)
#   }
# SolisCloud calls DC_TOTALPOWER "Power" and "DC Power PV 1(W)"
PLOTS = {
    "APPARENT_POWER": { 'name': 'Apparent Power', 'div': 1, 'unit': 'VA', 'type': 'line', 'type': 'line', 'color': 'darkred'},
    "DC_TOTALPOWER": { 'name': 'DC Total Power', 'div': 1, 'unit': 'W', 'type': 'line', 'color': 'red' },
    "REACTIVE_POWER": { 'name': 'Reactive Power', 'div': 1, 'unit': 'Var', 'type': 'line', 'color': 'purple' },
    "POWER_FACTOR": { 'name': 'Power Factor', 'div': 1, 'unit': 'pf%', 'type': 'line', 'color': 'blue' },
    "E_TODAY": { 'name': 'Energy Yield', 'div': 10, 'unit': 'kWh', 'type': 'bar', 'color': 'green' },
    "U_PV": { 'name': 'DC Voltage PV', 'div': 1, 'unit': 'V', 'type': 'line', 'color': 'brown', 'num': 0 },
    "I_PV": { 'name': 'DC Current PV', 'div': 1, 'unit': 'A', 'type': 'line', 'color': 'orange', 'num': 0  },
    "U_MPPT": { 'name': 'DC Voltage MPPT ', 'div': 1, 'unit': 'V', 'type': 'line', 'color': 'brown', 'num': 0  },
    "I_MPPT": { 'name': 'DC Current MPPT ', 'div': 1, 'unit': 'A', 'type': 'line', 'color': 'orange', 'num': 0  },
    "U_AC": { 'name': 'AC Voltage','div': 1, 'unit': 'V', 'type': 'line', 'color': 'brown', 'num': 0  },
    "I_AC": { 'name': 'AC Current', 'div': 1, 'unit': 'A', 'type': 'line', 'color': 'orange', 'num': 0  },
    "PAC": { 'name': 'AC Output Total Power', 'div': 1, 'unit': 'kW', 'type': 'line', 'color': 'hotpink', 'disabled': False},
    "FAC": { 'name': 'AC Frequency', 'div': 1, 'unit': 'Hz', 'type': 'line', 'color': 'teal', 'disabled': False },
}

DEBUG = False
DEBUG_LEVEL = 0
